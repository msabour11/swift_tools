 "html": "<style>\n  @page {\n    size: A4;\n    margin: 15mm 10mm;\n  }\n  \n  .print-format { \n    font-family: 'Arial', 'Segoe UI', sans-serif; \n    font-size: 12px; \n    color: #333;\n    direction: rtl;\n    width: 100%;\n  }\n  \n  .header { \n    text-align: center; \n    margin-bottom: 20px; \n    border-bottom: 2px solid #2c3e50; \n    padding-bottom: 10px; \n  }\n  \n  .header h2 { \n    margin: 0; \n    color: #2c3e50;\n    font-size: 18px;\n  }\n  \n  .header p { \n    margin: 5px 0 0; \n    color: #7f8c8d; \n    font-size: 11px; \n    direction: ltr;\n  }\n  \n  .section-title { \n    background: #ecf0f1; \n    padding: 8px 12px; \n    font-weight: bold; \n    margin-top: 15px;\n    margin-bottom: 5px;\n    border-right: 4px solid #2980b9;\n    border-left: none;\n    border-top: none !important;\n    border-bottom: none !important;\n    font-size: 13px;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n  \n  table.info { \n    width: 100%; \n    border-collapse: collapse; \n    margin: 5px 0;\n    table-layout: fixed;\n    border-top: none !important;\n    border-bottom: none !important;\n    border-left: none !important;\n    border-right: none !important;\n  }\n  \n  table.info td { \n    padding: 8px 10px; \n    border: none !important;\n    border-bottom: 1px solid #ddd !important;\n    vertical-align: top;\n    font-size: 12px;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n  \n  table.info .label { \n    width: 35%; \n    font-weight: 600;\n    border: none !important;\n    background: transparent !important;\n    box-shadow: none !important;\n  }\n  \n  table.child { \n    width: 100%; \n    border-collapse: collapse; \n    margin-top: 8px; \n    font-size: 11px;\n  }\n  \n  table.child th, table.child td { \n    border: 1px solid #999 !important; \n    padding: 6px 8px; \n    text-align: right;\n  }\n  \n  table.child th { \n    background: #dfe6e9 !important; \n    font-weight: 600;\n    font-size: 11px;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n  \n  .footer { \n    margin-top: 40px;\n    padding-top: 20px;\n  }\n  \n  .footer-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  \n  .footer-table td {\n    width: 50%;\n    padding: 10px;\n    text-align: center;\n    vertical-align: bottom;\n    border: none !important;\n  }\n  \n  .sign-box { \n    border-top: 1px solid #333 !important; \n    width: 150px; \n    text-align: center; \n    padding-top: 5px;\n    margin: 0 auto;\n    border-bottom: none !important;\n    border-left: none !important;\n    border-right: none !important;\n  }\n  \n  .no-data {\n    color: #7f8c8d; \n    font-style: italic;\n    padding: 10px;\n  }\n  \n  @media print {\n    .no-print { display: none; }\n    .print-format { width: 100%; margin: 0; padding: 0; }\n    table.info td { \n      border: none !important;\n      border-bottom: 1px solid #ddd !important;\n      background: transparent !important;\n      box-shadow: none !important;\n    }\n    table.info .label { \n      border: none !important;\n      background: transparent !important;\n      box-shadow: none !important;\n    }\n    table.info { \n      border: none !important; \n    }\n  }\n</style>\n\n<div class=\"print-format\">\n  <div class=\"header\">\n    <h2>\u062a\u0642\u0631\u064a\u0631 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0639\u0645\u064a\u0644</h2>\n    <p>\u0631\u0642\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f: {{ doc.name }} | \u0627\u0644\u062a\u0627\u0631\u064a\u062e: {{ doc.get_formatted(\"visit_time\") }}</p>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udccc \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629</div>\n  <table class=\"info\">\n    <tr>\n      <td class=\"label\">\u0627\u0644\u0639\u0645\u064a\u0644</td>\n      <td>{{ doc.customer_name or doc.customer }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0627\u0644\u0634\u0631\u0643\u0629</td>\n      <td>{{ doc.company }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</td>\n      <td>{{ doc.custom_sales_person }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629</td>\n      <td>{{ doc.custom_servicer_provider }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\udccb \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0632\u064a\u0627\u0631\u0629</div>\n  <table class=\"info\">\n    <tr>\n      <td class=\"label\">\u0647\u062f\u0641 \u0627\u0644\u0632\u064a\u0627\u0631\u0629</td>\n      <td>{{ doc.visit_objective }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0632\u064a\u0627\u0631\u0629</td>\n      <td>{{ doc.visit_outcome }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\ude9a \u0627\u0644\u0634\u062d\u0646 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0644\u0648\u062c\u0633\u062a\u064a\u0629</div>\n  <table class=\"info\">\n    <tr>\n      <td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u0646\u0642\u0644</td>\n      <td>{{ doc.custom_transportation_types }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0628\u0626\u0629</td>\n      <td>{{ doc.custom_packing_and_packaging_type }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629</td>\n      <td>{{ doc.custom_type_ }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0645\u062a\u0648\u0633\u0637 \u062d\u062c\u0645 \u0627\u0644\u0634\u062d\u0646\u0629</td>\n      <td>{{ doc.custom_average_shipment_size }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\udcb0 \u0627\u0644\u062a\u0633\u0639\u064a\u0631</div>\n  <table class=\"info\">\n    <tr>\n      <td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u062d\u0627\u0644\u064a</td>\n      <td>{{ doc.custom_current_rate_from_server_provider }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639</td>\n      <td>{{ doc.custom_expexted_rate }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 (\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a)</td>\n      <td>{{ doc.custom_expexted_rate__frome_sales__person }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\uddfa\ufe0f \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0631\u064a\u0642 / \u0627\u0644\u0627\u062a\u062c\u0627\u0647</div>\n  {% if doc.custom_direction_table %}\n  <table class=\"child\">\n    <thead>\n      <tr>\n        <th style=\"width:30px;\">#</th>\n        <th>\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0635\u062f\u0631</th>\n        <th>\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0648\u062c\u0647\u0629</th>\n        <th>\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u062d\u0627\u0644\u064a (\u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629)</th>\n        <th>\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639</th>\n        <th>\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 (\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a)</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.custom_direction_table %}\n      <tr>\n        <td style=\"text-align:center;\">{{ loop.index }}</td>\n        <td>{{ row.origin_city }}</td>\n        <td>{{ row.destination_city }}</td>\n        <td>{{ row.current_rate_from_server_provider }}</td>\n        <td>{{ row.expexted_rate }}</td>\n        <td>{{ row.expexted_rate_frome_sales_person }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% else %}\n  <p class=\"no-data\">\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0641\u0627\u0635\u064a\u0644 \u0637\u0631\u064a\u0642 \u0645\u0633\u062c\u0644\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u0632\u064a\u0627\u0631\u0629</p>\n  {% endif %}\n\n  <div class=\"footer\">\n    <table class=\"footer-table\">\n      <tr>\n        <td>\n          <div class=\"sign-box\">\u062a\u0648\u0642\u064a\u0639 \u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</div>\n        </td>\n        <td>\n          <div class=\"sign-box\">\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0645\u064a\u0644</div>\n        </td>\n      </tr>\n    </table>\n  </div>\n</div>",
