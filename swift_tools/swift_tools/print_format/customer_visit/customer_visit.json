 "html": "<style>\n  .print-format { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #333; }\n  .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; }\n  .header h2 { margin: 0; color: #2c3e50; }\n  .header p { margin: 5px 0 0; color: #7f8c8d; font-size: 11px; }\n  .section-title { background: #ecf0f1; padding: 8px; font-weight: bold; margin-top: 18px; border-left: 4px solid #2980b9; }\n  table.info { width: 100%; border-collapse: collapse; margin: 10px 0; }\n  table.info td { padding: 7px 10px; border-bottom: 1px solid #ddd; vertical-align: top; }\n  table.info .label { width: 40%; font-weight: 600; background: #f9f9f9; }\n  table.child { width: 100%; border-collapse: collapse; margin-top: 8px; }\n  table.child th, table.child td { border: 1px solid #bdc3c7; padding: 8px; text-align: left; }\n  table.child th { background: #dfe6e9; font-weight: 600; }\n  .footer { margin-top: 30px; display: flex; justify-content: space-between; font-size: 11px; color: #555; }\n  .sign-box { border-top: 1px solid #333; width: 150px; text-align: center; padding-top: 5px; }\n  @media print {\n    .no-print { display: none; }\n    .print-format { width: 100%; }\n  }\n</style>\n\n<div class=\"print-format\">\n  <div class=\"header\">\n    <h2>Customer Visit Report</h2>\n    <p>Document: {{ doc.name }} | Date: {{ doc.get_formatted(\"visit_time\") }}</p>\n  </div>\n\n  <div class=\"section-title\">\ud83d\udccc \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0627\u0633\u0627\u0633\u064a\u0629 </div>\n  <table class=\"info\">\n    <tr><td class=\"label\">\u0627\u0644\u0639\u0645\u064a\u0644</td><td>{{ doc.customer_name or doc.customer }}</td></tr>\n    <tr><td class=\"label\">\u0627\u0644\u0634\u0631\u0643\u0629</td><td>{{ doc.company }}</td></tr>\n    <tr><td class=\"label\">\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a </td><td>{{ doc.custom_sales_person }}</td></tr>\n    <tr><td class=\"label\">\u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629 </td><td>{{ doc.custom_servicer_provider }}</td></tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\udccb \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 </div>\n  <table class=\"info\">\n    <tr><td class=\"label\">\u0647\u062f\u0641 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 </td><td>{{ doc.visit_objective }}</td></tr>\n    <tr><td class=\"label\">\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 </td><td>{{ doc.visit_outcome }}</td></tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\ude9a \u0627\u0644\u0634\u062d\u0646 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0644\u0648\u062c\u0633\u062a\u064a\u0629  </div>\n  <table class=\"info\">\n    <tr><td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u0646\u0642\u0644</td><td>{{ doc.custom_transportation_types }}</td></tr>\n    <tr><td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 </td><td>{{ doc.custom_packing_and_packaging_type }}</td></tr>\n    <tr><td class=\"label\">\u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u0643\u0628\u0629</td><td>{{ doc.custom_type_ }}</td></tr>\n    <tr><td class=\"label\">\u0645\u062a\u0648\u0633\u0637 \u200b\u200b\u062d\u062c\u0645 \u0627\u0644\u0634\u062d\u0646\u0629</td><td>{{ doc.custom_average_shipment_size }}</td></tr>\n  </table>\n\n  <div class=\"section-title\">\ud83d\udcb0 \u0627\u0644\u062a\u0633\u0639\u064a\u0631 </div>\n  <table class=\"info\">\n    <tr><td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u062d\u0627\u0644\u064a</td><td>{{ doc.custom_current_rate_from_server_provider }}</td></tr>\n    <tr><td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639</td><td>{{ doc.custom_expexted_rate }}</td></tr>\n    <tr><td class=\"label\">\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u0644\u0644\u0645\u0646\u062f\u0648\u0628</td><td>{{ doc.custom_expexted_rate__frome_sales__person }}</td></tr>\n  </table>\n\n  <div class=\"section-title\"> \ud83d\uddfa\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0631\u064a\u0642 / \u0627\u0644\u0627\u062a\u062c\u0627\u0647 </div>\n  {% if doc.custom_direction_table %}\n  <table class=\"child\">\n    <thead>\n      <tr>\n        <th>#</th>\n        <th>Origin City</th>\n        <th>Destination City</th>\n        <th>Current Rate (Server)</th>\n        <th>Expected Rate</th>\n        <th>Expected Rate (Sales)</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.custom_direction_table %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ row.origin_city }}</td>\n        <td>{{ row.destination_city }}</td>\n        <td>{{ row.current_rate_from_server_provider }}</td>\n        <td>{{ row.expexted_rate }}</td>\n        <td>{{ row.expexted_rate_frome_sales_person }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% else %}\n  <p style=\"color: #7f8c8d; font-style: italic;\">No route details recorded for this visit.</p>\n  {% endif %}\n\n  <div class=\"footer\">\n    <div class=\"sign-box\">Sales Person Signature</div>\n    <div class=\"sign-box\">Customer Signature</div>\n  </div>\n</div>",
